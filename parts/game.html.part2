<script type="text/javascript">
"use strict";
(function(){
	window.eaglercraftXOpts.assetsURI = eaglerEPK("eagler-blob-0",40622165);

	var launchInterval = -1;
	var launchCounter = 1;
	var launchCountdownNumberElement = null;
	var launchCountdownProgressElement = null;
	var launchSkipCountdown = false;

	var launchTick = function() {
		launchCountdownNumberElement.innerText = "" + Math.floor(6.0 - launchCounter * 0.06);
		launchCountdownProgressElement.style.width = "" + launchCounter + "%";
		if(++launchCounter > 100 || launchSkipCountdown) {
			clearInterval(launchInterval);
			setTimeout(function() { document.body.removeChild(document.getElementById("launch_countdown_screen")); document.body.style.backgroundColor = "black"; main(); }, 50);
		}
	};

	window.addEventListener("load", function() {
		launchCountdownNumberElement = document.getElementById("launchCountdownNumber");
		launchCountdownProgressElement = document.getElementById("launchCountdownProgress");
		launchInterval = setInterval(launchTick, 50);
		document.getElementById("skipCountdown").addEventListener("click", function() {
			launchSkipCountdown = true;
		});
	});
})();
</script>
<link type="image/png" rel="shortcut icon" href="data:image/png;base64," />
<script id="eagler-mouse-fix">
// ==UserScript==
// @name         Eaglercraft Mouse Support (Touch-Safe)
// @namespace    local.eaglercraft.mouse-support
// @version      4.0.0
// @description  Touch-safe mouse support and pointer-lock emulation, with working screen edges.
// @match        *://*/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

/* Eaglercraft mouse support: touch-safe, lower-overhead version.
 * Optional URL settings: ?mousesens=1.8&touch=0&edge=4&edgecoast=160&edges=lr&touchui=auto&edgeauto=1&edgespeed=12
 * Touch controls: touchui=auto (hidden while a mouse is in use) | off (always hidden) | on, or the gear panel.
 * Open the panel any time with Alt+E or F8.
 * Edges are chosen in the gear panel (top-right, shown while not playing) or with
 * ?edges=all|lr|ud|none|left,top,... : when the pointer hits an enabled edge the camera keeps coasting in the direction you were
 * swinging and eases to a stop (edgecoast = how long in ms, 0 = off). It never runs away, and moving
 * the mouse back stops it instantly. Raw mouse movement is used at the edge when the browser reports it.
 * edgeauto=1 turns the old keep-turning-at-the-edge back on (off by default); edge=0 turns all edge handling off.
 * v5: inside the EaglerMC iPad app the pointer is really locked (raw mouse movement, no edges).
 * v4.1: no simulated turning any more, the camera only follows real mouse movement.
 * v4: O is the Escape key (change it in the gear panel: Escape key). A custom menu cursor replaces the iOS pointer
 * while a menu is showing, and the screen edges are reachable. Holding the mouse at an edge keeps the camera
 * turning (gear panel: Mouse edges). Optional on-screen ESC button in the panel.
 * Add ?mousedebug for diagnostics. The page is never reloaded or redirected.
 */
(function () {
  'use strict';

  var q = new URLSearchParams(location.search);
  function num(key, def) {
    var v = parseFloat(q.get(key));
    return isFinite(v) && v > 0 ? v : def;
  }
  var SENS = num('mousesens', 1.8);
  var EDGE = q.has('edge') ? Math.max(0, parseFloat(q.get('edge')) || 0) : 4;
  // Which edges help you turn, and how long the coast lasts. Chosen in the gear panel (saved on
  // this device); ?edges=... / ?edgecoast=... override it for that visit.
  function parseEdges(s) {
    if (s == null) return null;
    s = String(s).toLowerCase().trim();
    var presets = { all: 'ltrb', both: 'ltrb', lr: 'lr', sides: 'lr', horizontal: 'lr', leftright: 'lr',
      ud: 'tb', tb: 'tb', updown: 'tb', vertical: 'tb', none: '', off: '', '0': '' };
    var keys = presets.hasOwnProperty(s) ? presets[s].split('') : null;
    if (!keys) {
      keys = [];
      var names = { left: 'l', l: 'l', right: 'r', r: 'r', top: 't', up: 't', t: 't', u: 't', bottom: 'b', down: 'b', b: 'b', d: 'b' };
      s.split(/[\s,+|]+/).forEach(function (w) { if (names.hasOwnProperty(w)) keys.push(names[w]); });
      if (!keys.length) return null;
    }
    var m = { l: false, r: false, t: false, b: false };
    keys.forEach(function (k) { m[k] = true; });
    return m;
  }
  var SKEY = 'eagler.mouseEdges';
  var EDGES = { l: true, r: true, t: false, b: false };
  var COAST = 0;
  try {
    var sv = JSON.parse(lsGet(SKEY) || 'null');
    if (sv && sv.e) EDGES = { l: !!sv.e.l, r: !!sv.e.r, t: !!sv.e.t, b: !!sv.e.b };
  } catch (e) {}
  (function () {
    var m = q.has('edges') ? parseEdges(q.get('edges')) : (q.get('edgey') === '1' ? parseEdges('all') : null);
    if (m) EDGES = m;
    if (q.has('edgecoast')) COAST = Math.max(0, parseFloat(q.get('edgecoast')) || 0);
  })();
  // Extra settings, saved on this device.
  var OKEY = 'eagler.mouseOpts';
  var OPTS = { esc: 'KeyO', escLabel: 'O', cursor: true, snap: 8, turn: false, speed: 12, band: 48, sens: 0, escBtn: false };
  try {
    var so = JSON.parse(lsGet(OKEY) || 'null');
    if (so) Object.keys(OPTS).forEach(function (k) { if (typeof so[k] === typeof OPTS[k]) OPTS[k] = so[k]; });
  } catch (e) {}
  if (q.get('menucursor') === '0') OPTS.cursor = false;
  // Running inside the iPad app wrapper (EaglerMC): the app locks the pointer and sends raw mouse movement.
  var NATIVE = !!(window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.eaglerNative);
  if (NATIVE) OPTS.cursor = true;
  // Inside the app the native side already sends every mouse move and click. The real iOS mouse events would
  // arrive a second time (cursor wiggling in menus, clicks counted two or three times), so they are dropped.
  if (NATIVE) {
    var nTouchT = -1e9;
    ['touchstart', 'touchend'].forEach(function (t) {
      window.addEventListener(t, function () { nTouchT = performance.now(); }, { capture: true, passive: true });
    });
    ['pointermove', 'pointerdown', 'pointerup', 'mousemove', 'mousedown', 'mouseup', 'click', 'dblclick', 'auxclick', 'contextmenu', 'wheel']
      .forEach(function (t) {
        window.addEventListener(t, function (e) {
          if (!e.isTrusted) return;                                   // our own events from the app: keep
          if (e.pointerType && e.pointerType !== 'mouse') return;     // finger / pen: keep
          if (performance.now() - nTouchT < 800) return;              // mouse events a finger tap makes: keep
          if (panelOpen()) return;                                    // settings panel open: normal pointer
          e.stopImmediatePropagation();
          if (t === 'contextmenu') e.preventDefault();
        }, true);
      });
  }
  if (OPTS.sens > 0 && !q.has('mousesens')) SENS = OPTS.sens;
  function saveOpts() { lsSet(OKEY, JSON.stringify(OPTS)); }
  function edgeAuto() { return q.get('edgeauto') === '1'; }   // simulated turning is off; only real mouse movement is used
  function edgeSpeed() { return q.has('edgespeed') ? num('edgespeed', 12) : OPTS.speed; }
  var DEBUG = q.has('mousedebug');
  var KEY = 'eagler.mouseConnected';

  function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function lsSet(k, v) {
    try { if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) {}
  }
  // ---- Touch controls: keep them hidden while you play with mouse + keyboard ----
  // The game decides to draw its touch controls from what the browser says about touch support,
  // so while "hidden" we report no touch support and keep touch input away from the game.
  var TKEY = 'eagler.touchMode';
  var TMODE = (function () {
    var p = q.get('touchui'), s = lsGet(TKEY);
    var v = (p === 'auto' || p === 'off' || p === 'on') ? p : s;
    return (v === 'off' || v === 'on') ? v : 'auto';
  })();
  var mouseMode = false, mouseSaved = lsGet(KEY) === '1', lastMouseT = -1e9;
  try {
    mouseMode = q.get('touch') !== '1' && (q.get('touch') === '0' || mouseSaved ||
      !!(window.matchMedia && matchMedia('(any-pointer: fine)').matches));
  } catch (e) {}
  function setTouchMode(m) { TMODE = m; lsSet(TKEY, m === 'auto' ? null : m); }
  function touchBlocked() { return TMODE === 'off' || (TMODE === 'auto' && mouseMode); }

  try {   // navigator.maxTouchPoints
    var mtp = Object.getOwnPropertyDescriptor(Navigator.prototype, 'maxTouchPoints');
    if (mtp && mtp.get) {
      Object.defineProperty(Navigator.prototype, 'maxTouchPoints', {
        get: function () { return touchBlocked() ? 0 : mtp.get.call(this); },
        configurable: true, enumerable: mtp.enumerable
      });
    }
  } catch (e) {}
  try {   // 'ontouchstart' in window / element checks (decided once, at load)
    if (touchBlocked()) {
      ['ontouchstart', 'ontouchend', 'ontouchmove', 'ontouchcancel'].forEach(function (n) {
        [window, Window.prototype, Document.prototype, Element.prototype, HTMLElement.prototype].forEach(function (o) {
          try { delete o[n]; } catch (e) {}
        });
      });
    }
  } catch (e) {}
  try {   // (pointer: coarse) / (hover: none) media queries
    var realMM = window.matchMedia;
    if (realMM) {
      window.matchMedia = function (qs) {
        var r = realMM.call(window, qs);
        if (touchBlocked() && /pointer\s*:\s*coarse|hover\s*:\s*none/i.test(String(qs))) {
          return new Proxy(r, { get: function (t, p) {
            if (p === 'matches') return false;
            var v = t[p];
            return typeof v === 'function' ? v.bind(t) : v;
          } });
        }
        return r;
      };
    }
  } catch (e) {}
  // A real mouse moving means mouse mode (remembered for next time so the next load starts hidden).
  window.addEventListener('pointermove', function (e) {
    if (e.pointerType !== 'mouse') return;
    lastMouseT = performance.now();
    mouseMode = true;
    if (!mouseSaved && TMODE !== 'on') { mouseSaved = true; lsSet(KEY, '1'); }
  }, true);
  var touchBlockInstalled = false;
  function installTouchBlock() {
    if (touchBlockInstalled) return;
    touchBlockInstalled = true;
    ['touchstart', 'touchmove', 'touchend', 'touchcancel', 'pointerdown', 'pointermove', 'pointerup', 'pointercancel']
      .forEach(function (t) {
        window.addEventListener(t, function (e) {
          if (!(t.indexOf('touch') === 0 || e.pointerType === 'touch')) return;
          // In Auto, a finger on the screen after the mouse has been idle brings the touch controls back.
          if ((t === 'touchstart' || t === 'pointerdown') && TMODE === 'auto' && mouseMode &&
              performance.now() - lastMouseT > 4000) mouseMode = false;
          if (touchBlocked()) e.stopImmediatePropagation();
        }, { capture: true, passive: true });
      });
  }

  // ---- Escape key: a key of your choice (O by default) presses Escape in the game ----
  var synthKeys = new WeakSet();
  var escDown = false;
  var capturing = null;      // set by the gear panel while it waits for you to press a new key
  var uiPanel = null;        // the gear panel (so the key is left alone while it is open)
  function sendEsc(type, target) {
    var ev;
    try {
      ev = new KeyboardEvent(type, { key: 'Escape', code: 'Escape', keyCode: 27, which: 27,
        bubbles: true, cancelable: true, composed: true, view: window });
      Object.defineProperty(ev, 'keyCode', { value: 27 });
      Object.defineProperty(ev, 'which', { value: 27 });
    } catch (e) { return; }
    synthKeys.add(ev);
    (target || document.body || document).dispatchEvent(ev);
  }
  function pressEsc() {
    var t = document.querySelector('canvas') || document.activeElement || document.body;
    sendEsc('keydown', t);
    setTimeout(function () { sendEsc('keyup', t); }, 40);
  }
  function onKey(e) {
    if (synthKeys.has(e)) return;
    if (capturing) {
      e.stopImmediatePropagation(); e.preventDefault();
      if (e.type === 'keydown' && !e.repeat) { var cb = capturing; capturing = null; cb(e); }
      return;
    }
    if (!OPTS.esc || e.code !== OPTS.esc || e.ctrlKey || e.metaKey || e.altKey) return;
    if (uiPanel && uiPanel.style.display === 'block') return;
    e.stopImmediatePropagation(); e.preventDefault();      // the game never sees the real key
    if (e.type === 'keydown') {
      if (e.repeat || escDown) return;
      escDown = true;
      sendEsc('keydown', e.target);
    } else if (e.type === 'keyup') {
      if (!escDown) return;
      escDown = false;
      sendEsc('keyup', e.target);
    }
  }
  ['keydown', 'keyup', 'keypress'].forEach(function (t) { window.addEventListener(t, onKey, true); });
  window.addEventListener('blur', function () { if (escDown) { escDown = false; sendEsc('keyup', document.body); } });

  var escBtn = null;
  function escBtnUpdate() {
    if (!document.body) return;
    if (!OPTS.escBtn) { if (escBtn) escBtn.style.display = 'none'; return; }
    if (!escBtn) {
      escBtn = document.createElement('button');
      escBtn.id = 'eagler-esc-btn';
      escBtn.textContent = 'ESC';
      escBtn.style.cssText = 'position:fixed;top:max(6px,env(safe-area-inset-top));left:max(6px,env(safe-area-inset-left));' +
        'z-index:2147483645;min-width:48px;height:34px;padding:0 10px;border-radius:8px;border:1px solid #fff8;' +
        'background:#000a;color:#fff;font:700 13px -apple-system,sans-serif;opacity:.7;cursor:pointer';
      escBtn.addEventListener('click', function (e) { e.stopPropagation(); pressEsc(); });
      ['mousedown', 'mouseup', 'dblclick', 'pointerdown', 'pointerup', 'touchstart', 'touchend', 'wheel']
        .forEach(function (t) { escBtn.addEventListener(t, function (e) { e.stopPropagation(); }); });
      document.body.appendChild(escBtn);
    }
    escBtn.style.display = 'block';
  }

  // Use the native implementation only when both halves of the API exist.
  var native = typeof Element.prototype.requestPointerLock === 'function'
    && ('pointerLockElement' in Document.prototype);
  if (native) { installTouchBlock(); return; }

  var locked = null;
  var lastX = null, lastY = null, cx = 0, cy = 0;
  var lastTouch = -1e9;
  var sent = new WeakSet();
  var edgeFrame = 0;
  var outside = false;   // pointer left the page (toolbar, home bar, off-screen)
  var pinSince = 0;      // when the pointer got pinned at an edge
  var rawT = -1e9;       // last time the browser reported raw movement while pinned -> no auto-turn needed then
  function rawRecent() { return performance.now() - rawT < 250; }
  var dbg = { last: '-', box: null };

  function fire(type) {
    setTimeout(function () { document.dispatchEvent(new Event(type)); }, 0);
  }
  function active() {
    if (locked && !locked.isConnected) {
      locked = null;
      fire('pointerlockchange');
      stopEdgeLoop();
    }
    return !!locked;
  }
  function stopEdgeLoop() {
    if (edgeFrame) {
      cancelAnimationFrame(edgeFrame);
      edgeFrame = 0;
    }
    pinSince = 0;
    coast = null;
  }

  Object.defineProperty(Document.prototype, 'pointerLockElement', {
    get: function () { return active() ? locked : null; },
    configurable: true
  });
  Element.prototype.requestPointerLock = function () {
    if (!this.isConnected) {
      fire('pointerlockerror');
      return Promise.resolve();
    }
    var changed = locked !== this;
    locked = this;
    if (changed) fire('pointerlockchange');
    scheduleEdgeLoop();
    return Promise.resolve();
  };
  Document.prototype.exitPointerLock = function () {
    if (locked) {
      locked = null;
      fire('pointerlockchange');
    }
    stopEdgeLoop();
  };

  function dbgShow() {
    if (!DEBUG) return;
    if (!dbg.box) {
      dbg.box = document.createElement('div');
      dbg.box.style.cssText = 'position:fixed;left:4px;bottom:4px;z-index:2147483647;background:#000a;color:#0f0;' +
        'font:12px monospace;padding:4px 6px;pointer-events:none;white-space:pre';
      (document.body || document.documentElement).appendChild(dbg.box);
    }
    dbg.box.textContent = 'lock=' + (locked ? locked.tagName : 'no') + ' touch=' + (q.get('touch') || 'auto') +
      '\ncursor=' + Math.round(cx) + ',' + Math.round(cy) + ' last=' + dbg.last +
      '\nedge=' + edgeDir().join(',') + ' out=' + outside + ' raw=' + rawRecent() + ' tui=' + TMODE + (touchBlocked() ? ':hidden' : ':shown');
  }

  function emit(dx, dy) {
    if (!active() || document.hidden || (!dx && !dy)) return;
    var ev = new MouseEvent('mousemove', {
      bubbles: true, cancelable: true, view: window,
      clientX: Math.round(window.innerWidth / 2), clientY: Math.round(window.innerHeight / 2)   // like a locked pointer: parked in the middle, only the movement counts
    });
    try {
      Object.defineProperty(ev, 'movementX', { value: dx });
      Object.defineProperty(ev, 'movementY', { value: dy });
    } catch (e) {}
    sent.add(ev);
    locked.dispatchEvent(ev);
    if (DEBUG) dbg.last = dx.toFixed(1) + ',' + dy.toFixed(1);
  }

  function noteTouch() {
    lastTouch = performance.now();
    // Avoid a large jump when the mouse is moved after using touch settings.
    lastX = lastY = null;
    haveMouse = false; cursorSoon();   // a finger is in use: hide the menu cursor until the mouse moves again
  }
  window.addEventListener('touchstart', noteTouch, { capture: true, passive: true });
  window.addEventListener('touchend', noteTouch, { capture: true, passive: true });
  window.addEventListener('touchcancel', noteTouch, { capture: true, passive: true });
  installTouchBlock();   // after noteTouch so that still sees every touch first

  var EDGE_OUT = 60;     // px: last known position must be this close when the pointer leaves the page
  var EDGE_DELAY = 60;   // ms pinned before auto-turn starts (so brushing an edge does nothing)
  var EDGE_RAMP = 200;   // ms to reach full auto-turn speed

  // Which screen edges is the pointer pushed against? -1 / 0 / 1 per axis.
  function edgeDir() {
    if (!EDGE) return [0, 0];
    var z = outside ? Math.max(EDGE, EDGE_OUT) : EDGE;
    var w = window.innerWidth, h = window.innerHeight;
    return [
      cx <= z ? (EDGES.l ? -1 : 0) : (cx >= w - 1 - z ? (EDGES.r ? 1 : 0) : 0),
      cy <= z ? (EDGES.t ? -1 : 0) : (cy >= h - 1 - z ? (EDGES.b ? 1 : 0) : 0)
    ];
  }
  // Dynamic edge turning: inside the edge zone the camera keeps turning, faster the closer you are to the
  // edge, and faster the harder you swung into it. Pinned on the very edge = full strength. Easing in, no jumps.
  var dirX = 0, dirY = 0, dirT = -1e9, swing = 0;   // last mouse direction / time / swing speed (px per ms)
  function edgeDepth() {   // per axis: -1..1, sign = which edge, size = how deep into the zone (0 = not in it)
    var w = window.innerWidth, h = window.innerHeight, B = Math.max(EDGE, OPTS.band), recent = performance.now() - dirT < 300;
    function axis(v, size, lo, hi, dir) {
      var dist = Math.min(v, size - 1 - v), side = v < size / 2 ? -1 : 1;
      if (!(side < 0 ? lo : hi) || dist > B) return 0;
      var pinned = dist <= (outside ? Math.max(EDGE, EDGE_OUT) : EDGE);
      if (!pinned && !(recent && dir === side)) return 0;    // in the zone but not heading outward: leave it alone
      var k = pinned ? 1 : 1 - dist / B;
      return side * Math.pow(k, 1.5);
    }
    return [axis(cx, w, EDGES.l, EDGES.r, dirX), axis(cy, h, EDGES.t, EDGES.b, dirY)];
  }
  function edgeTick(t) {
    edgeFrame = 0;
    if (!edgeAuto() || !active() || document.hidden || lastX === null || rawRecent()) { pinSince = 0; return; }
    var d = edgeDepth(), ex = d[0], ey = d[1];
    if (!ex && !ey) { pinSince = 0; return; }
    if (!pinSince) pinSince = t;
    var held = t - pinSince - EDGE_DELAY;
    if (held > 0) {
      var dt = Math.min(50, Math.max(0, t - (edgeTick.prev || t))) / 16.667;
      var ramp = Math.min(1, held / EDGE_RAMP);
      var boost = 0.6 + Math.min(1.4, swing * Math.exp(-held / 900));   // harder swing = faster turn, fading while held
      var k = ramp * boost * edgeSpeed() * dt;
      emit(ex * k, ey * k);
    }
    edgeTick.prev = t;
    edgeFrame = requestAnimationFrame(edgeTick);
    dbgShow();
  }
  function scheduleEdgeLoop() {
    if (!edgeFrame && edgeAuto() && EDGE && active() && !document.hidden && lastX !== null) {
      edgeTick.prev = performance.now();
      edgeFrame = requestAnimationFrame(edgeTick);
    }
  }

  // Edge coasting: the pointer stops dead at the screen edge, so carry the swing on for a
  // moment and ease it out. Distance scales with how hard you swung; moving back cancels it.
  var vx = 0, vy = 0, lastEvT = 0, coast = null, coastFrame = 0;
  function armCoast(ex, ey) {
    if (!COAST) return;
    var sx = ex && vx * ex > 0.1 ? vx : 0;   // px/ms, only if it points out of the screen
    var sy = ey && vy * ey > 0.1 ? vy : 0;
    if (!sx && !sy) return;
    var n = performance.now();
    coast = { x: sx, y: sy, t0: n, prev: n };
    if (!coastFrame) coastFrame = requestAnimationFrame(coastTick);
  }
  function coastTick(t) {
    coastFrame = 0;
    if (!coast || !active() || document.hidden) { coast = null; return; }
    var d = edgeDir();
    if (coast.x && d[0] * coast.x <= 0) coast.x = 0;   // moved away from that edge
    if (coast.y && d[1] * coast.y <= 0) coast.y = 0;
    var k = Math.exp(-(t - coast.t0) / COAST);
    if ((!coast.x && !coast.y) || k < 0.03) { coast = null; return; }
    var dt = Math.min(50, Math.max(0, t - coast.prev));
    coast.prev = t;
    emit(coast.x * dt * k * SENS, coast.y * dt * k * SENS);
    coastFrame = requestAnimationFrame(coastTick);
  }

  window.addEventListener('mousemove', function (e) {
    if (sent.has(e)) return;
    // Filter synthesized mouse events caused by a finger tap, not real mouse
    // movement for a long 800 ms window. Resetting the baseline prevents jumps.
    try {
      if (e.sourceCapabilities && e.sourceCapabilities.firesTouchEvents) return;
    } catch (x) {}
    if (performance.now() - lastTouch < 180) return;

    outside = false;
    var had = lastX !== null;
    var x = e.clientX, y = e.clientY;
    var dx = had ? x - lastX : 0;
    var dy = had ? y - lastY : 0;
    var now = performance.now(), vdt = Math.max(1, now - lastEvT);
    lastEvT = now;
    if (!had || vdt > 100) { vx = vy = 0; }
    else {
      vx = Math.max(-2.5, Math.min(2.5, vx * 0.4 + (dx / vdt) * 0.6));
      vy = Math.max(-2.5, Math.min(2.5, vy * 0.4 + (dy / vdt) * 0.6));
    }
    if (had && (dx || dy)) {
      if (Math.abs(dx) >= Math.abs(dy) * 0.5 && dx) dirX = dx > 0 ? 1 : -1;
      if (Math.abs(dy) >= Math.abs(dx) * 0.5 && dy) dirY = dy > 0 ? 1 : -1;
      swing = Math.max(Math.min(2.5, Math.hypot(vx, vy)), swing * Math.exp(-(now - dirT) / 250)); dirT = now;
    }
    lastX = cx = x;
    lastY = cy = y;

    // Pinned against a screen edge the position stops changing, so use the raw
    // hardware delta (movementX/Y) there if the browser still reports it.
    var d = [0, 0], rawX = false, rawY = false;
    if (had && EDGE) {
      d = edgeDir();
      var mx = e.movementX || 0, my = e.movementY || 0;
      // Outward push at an edge: take the raw delta whenever it is bigger than what the
      // clamped pointer position shows (covers both the last bit before the edge and pushing past it).
      if (mx * d[0] > 0 && Math.abs(mx) > Math.abs(dx)) { dx = mx; rawX = true; rawT = performance.now(); }
      if (my * d[1] > 0 && Math.abs(my) > Math.abs(dy)) { dy = my; rawY = true; rawT = performance.now(); }
    }

    if (!active()) { menuPlace(e); cursorSoon(); return; }   // in a menu: custom cursor, edge-reach coordinates
    e.stopImmediatePropagation();
    if (dx || dy) emit(dx * SENS, dy * SENS);
    // Swung into an edge (and the browser isn't giving us raw movement there): coast on briefly.
    if (had && EDGE && COAST) {
      var ax = !rawX && d[0] && dx * d[0] > 0 ? d[0] : 0;
      var ay = !rawY && d[1] && dy * d[1] > 0 ? d[1] : 0;
      if (ax || ay) armCoast(ax, ay);
    }
    scheduleEdgeLoop();
  }, true);

  // Pointer left the page (e.g. into the Safari toolbar / past the screen edge):
  // treat that as being pushed against the nearest edge.
  window.addEventListener('mouseout', function (e) {
    if (!e.relatedTarget) { inPage = false; cursorSoon(); }
    if (e.relatedTarget || !EDGE || !active()) return;
    outside = true;
    var od = edgeDir();
    armCoast(od[0], od[1]);
    scheduleEdgeLoop();
  }, true);
  window.addEventListener('mouseover', function () { outside = false; inPage = true; cursorSoon(); }, true);


  // ---- Menu cursor: our own arrow replaces the iOS pointer while a menu is showing ----
  var curEl = null, curStyle = null, curRaf = 0;
  var mx = 0, my = 0, haveMouse = false, inPage = true;
  function cursorStyle() {
    if (!curStyle) {
      curStyle = document.createElement('style');
      curStyle.id = 'eagler-cursor-style';
      curStyle.textContent = 'html.eagler-nocursor,html.eagler-nocursor *{cursor:url("data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7") 0 0,none !important}';
      (document.head || document.documentElement).appendChild(curStyle);
    }
  }
  cursorStyle();
  cursorSoon();
  function ensureCursor() {
    if (curEl || !document.body) return curEl;
    curEl = document.createElement('div');
    curEl.id = 'eagler-cursor';
    curEl.style.cssText = 'position:fixed;left:0;top:0;width:20px;height:28px;z-index:2147483647;pointer-events:none;' +
      'display:none;will-change:transform;filter:drop-shadow(0 1px 1px rgba(0,0,0,.6))';
    curEl.innerHTML = '<svg width="20" height="28" viewBox="0 0 20 28" xmlns="http://www.w3.org/2000/svg">' +
      '<path d="M1.5 1.5v21l5.2-4.9 3.6 8.3 3.7-1.6-3.6-8.2 7.2-.4z" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linejoin="round"/></svg>';
    document.body.appendChild(curEl);
    return curEl;
  }
  function cursorUpdate() {
    curRaf = 0;
    // The iOS pointer is hidden while playing, and in menus whenever the custom arrow is on.
    var pOpen = NATIVE && panelOpen();   // settings panel open in the app: show the normal pointer
    document.documentElement.classList.toggle('eagler-nocursor', !pOpen && (active() || OPTS.cursor));
    var el = ensureCursor();
    if (!el) return;
    if (!(OPTS.cursor && haveMouse && inPage && !document.hidden && !active() && !pOpen)) { el.style.display = 'none'; return; }
    el.style.display = 'block';
    el.style.transform = 'translate(' + (mx - 1.5) + 'px,' + (my - 1.5) + 'px)';
  }
  function cursorSoon() { if (!curRaf) curRaf = requestAnimationFrame(cursorUpdate); }
  document.addEventListener('pointerlockchange', cursorSoon);
  document.addEventListener('visibilitychange', cursorSoon);

  // The iOS pointer stops dead at the screen edge, which made the edge pixels hard to hit. Squeeze the
  // outer OPTS.snap px of the screen onto the very edge so the cursor can sit exactly on it.
  function mapEdge(v, size) {
    var m = OPTS.snap;
    if (!m || size < m * 6) return v;
    var r = (v - m) * (size - 1) / (size - 1 - 2 * m);
    r = Math.round(r);
    return r < 0 ? 0 : (r > size - 1 ? size - 1 : r);
  }
  function spoof(e, X, Y) {
    var r = { left: 0, top: 0 };
    try { r = e.target.getBoundingClientRect(); } catch (x) {}
    var d = { clientX: X, clientY: Y, x: X, y: Y, pageX: X + (window.pageXOffset || 0), pageY: Y + (window.pageYOffset || 0),
      offsetX: X - r.left, offsetY: Y - r.top };
    Object.keys(d).forEach(function (k) {
      try { Object.defineProperty(e, k, { value: d[k], configurable: true }); } catch (x) {}
    });
  }
  function fromTouch(e) {
    try { if (e.sourceCapabilities && e.sourceCapabilities.firesTouchEvents) return true; } catch (x) {}
    return performance.now() - lastTouch < 180;
  }
  // In a menu: work out where our cursor is and tell the game that is where the mouse is.
  function menuPlace(e) {
    var t = e.target, X = e.clientX, Y = e.clientY;
    var onUi = !!(t && t.closest && t.closest('#eagler-edge-ui,#eagler-esc-btn'));
    if (!onUi && OPTS.cursor) {
      X = mapEdge(X, window.innerWidth);
      Y = mapEdge(Y, window.innerHeight);
      spoof(e, X, Y);
    }
    mx = X; my = Y; haveMouse = true;
  }
  ['mousedown', 'mouseup', 'click', 'dblclick', 'auxclick', 'contextmenu', 'wheel', 'pointerdown', 'pointerup', 'pointermove']
    .forEach(function (t) {
      window.addEventListener(t, function (e) {
        if (sent.has(e) || active()) return;
        if (t.indexOf('pointer') === 0 ? e.pointerType !== 'mouse' : fromTouch(e)) return;
        menuPlace(e);
        if (t === 'pointermove') cursorSoon();
      }, true);
    });


  // ---- iPad app bridge: raw mouse movement from the native app (pointer is locked there) ----
  function panelOpen() { return !!(uiPanel && uiPanel.style.display === 'block'); }
  function postNative(o) { try { window.webkit.messageHandlers.eaglerNative.postMessage(o); } catch (e) {} }
  function syncLock() { if (NATIVE) postNative({ lock: !panelOpen() }); }
  var btnMask = 0;
  function nMouse(type, b, X, Y) {
    var ev = new MouseEvent(type, { bubbles: true, cancelable: true, view: window, clientX: X, clientY: Y,
      screenX: X, screenY: Y, button: b, buttons: btnMask, detail: 1 });
    sent.add(ev);
    return ev;
  }
  function nPoint() {   // where the game thinks the mouse is: the middle while playing, our cursor in menus
    if (active()) return { X: Math.round(window.innerWidth / 2), Y: Math.round(window.innerHeight / 2), t: locked };
    var X = Math.round(mx), Y = Math.round(my);
    return { X: X, Y: Y, t: document.elementFromPoint(X, Y) || document.body };
  }
  window.eaglerNative = {
    move: function (dx, dy) {
      if (panelOpen() || document.hidden || (!dx && !dy)) return;
      if (active()) { emit(dx * SENS, dy * SENS); return; }       // playing: just the movement, like a locked pointer
      if (!haveMouse) { mx = window.innerWidth / 2; my = window.innerHeight / 2; }
      haveMouse = true; inPage = true;
      mx = Math.max(0, Math.min(window.innerWidth - 1, mx + dx * SENS));   // menus: our own cursor, exact edges
      my = Math.max(0, Math.min(window.innerHeight - 1, my + dy * SENS));
      var p = nPoint();
      p.t.dispatchEvent(nMouse('mousemove', 0, p.X, p.Y));
      cursorSoon();
    },
    button: function (b, down) {
      if (panelOpen() || document.hidden) return;
      var bit = b === 0 ? 1 : (b === 2 ? 2 : 4);
      btnMask = down ? (btnMask | bit) : (btnMask & ~bit);
      var menu = !active(), p = nPoint();
      p.t.dispatchEvent(nMouse(down ? 'mousedown' : 'mouseup', b, p.X, p.Y));
      if (!down && menu && b === 0) p.t.dispatchEvent(nMouse('click', 0, p.X, p.Y));
    },
    wheel: function (dy) {
      if (panelOpen() || document.hidden || !dy) return;
      var p = nPoint();
      var ev = new WheelEvent('wheel', { bubbles: true, cancelable: true, view: window, clientX: p.X, clientY: p.Y,
        deltaY: -dy * 40, deltaMode: 0 });
      sent.add(ev);
      p.t.dispatchEvent(ev);
    }
  };
  if (NATIVE) { document.addEventListener('pointerlockchange', syncLock); window.addEventListener('load', syncLock); }

  // ---- Settings panel: gear button (top-right), only shown while you are not playing ----
  function buildUi() {
    if (q.get('touch') === '1' || document.getElementById('eagler-edge-ui') || !document.body) return;
    var SIDES = [['t', 'Top', '1 / 2'], ['l', 'Left', '2 / 1'], ['r', 'Right', '2 / 3'], ['b', 'Bottom', '3 / 2']];
    var PRESETS = [['Left / Right', 'lr'], ['Up / Down', 'tb'], ['All sides', 'ltrb'], ['Off', '']];
    var BTN = 'border:2px solid #666;border-radius:8px;color:#fff;font:600 14px -apple-system,sans-serif;' +
      'padding:8px;cursor:pointer;background:#333;min-height:44px;box-sizing:border-box';
    function mk(tag, css, text, parent) {
      var el = document.createElement(tag);
      if (css) el.style.cssText = css;
      if (text) el.textContent = text;
      if (parent) parent.appendChild(el);
      return el;
    }
    function paint(b, on) { b.style.background = on ? '#2e7d32' : '#333'; b.style.borderColor = on ? '#8fe08f' : '#666'; }
    function same(keys) { return ['l', 'r', 't', 'b'].every(function (k) { return EDGES[k] === (keys.indexOf(k) >= 0); }); }
    function save() { lsSet(SKEY, JSON.stringify({ e: EDGES, c: COAST })); coast = null; }

    var root = mk('div', 'position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483646;pointer-events:none;' +
      'font:14px/1.3 -apple-system,BlinkMacSystemFont,sans-serif;color:#fff');
    root.id = 'eagler-edge-ui';
    var gear = mk('button', 'position:absolute;top:max(6px,env(safe-area-inset-top));right:max(6px,env(safe-area-inset-right));' +
      'width:34px;height:34px;border-radius:8px;border:1px solid #fff8;background:#000a;color:#fff;font-size:18px;' +
      'line-height:1;padding:0;opacity:.6;pointer-events:auto;cursor:pointer', '\u2699\uFE0E', root);
    gear.title = 'Mouse & key settings';
    var panel = mk('div', 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(92vw,340px);' +
      'max-height:92%;overflow:auto;box-sizing:border-box;padding:14px;border-radius:14px;background:#1b1b1bf2;' +
      'border:2px solid #fff;pointer-events:auto;display:none', '', root);

    var head = mk('div', 'display:flex;justify-content:space-between;align-items:center;margin-bottom:6px', '', panel);
    mk('div', 'font-weight:700;font-size:16px', 'Mouse & keys settings', head);
    var close = mk('button', BTN + ';min-height:34px;padding:2px 10px', '\u2715', head);
    var extraRefresh = [];
    function toggle(label, get, set, parent) {
      var b = mk('button', BTN + ';width:100%;margin-top:6px', '', parent);
      b.addEventListener('click', function () { set(!get()); saveOpts(); refresh(); });
      extraRefresh.push(function () { b.textContent = label + ': ' + (get() ? 'On' : 'Off'); paint(b, get()); });
    }
    function sliderRow(label, min, max, step, get, set, fmt, parent) {
      var lbl = mk('div', 'margin:8px 0 4px', '', parent);
      var s = mk('input', 'width:100%;margin:0 0 4px', '', parent);
      s.type = 'range'; s.min = min; s.max = max; s.step = step;
      s.addEventListener('input', function () { set(+s.value); saveOpts(); refresh(); });
      extraRefresh.push(function () { s.value = get(); lbl.textContent = label + ': ' + fmt(get()); });
    }

    mk('div', 'margin:10px 0 4px;font-weight:700', 'Escape key', panel);
    var escRow = mk('div', 'display:flex;gap:6px;align-items:stretch', '', panel);
    var escSet = mk('button', BTN + ';flex:3', '', escRow);
    var escOff = mk('button', BTN + ';flex:1', 'Off', escRow);
    var escO = mk('button', BTN + ';flex:1', 'O', escRow);
    escSet.addEventListener('click', function () {
      if (capturing) { capturing = null; refresh(); return; }
      capturing = function (e) {
        if (e.code !== 'Escape') {
          OPTS.esc = e.code;
          OPTS.escLabel = (e.key && e.key.length === 1) ? e.key.toUpperCase() : e.code;
          saveOpts();
        }
        refresh();
      };
      refresh();
    });
    escOff.addEventListener('click', function () { capturing = null; OPTS.esc = ''; OPTS.escLabel = ''; saveOpts(); refresh(); });
    escO.addEventListener('click', function () { capturing = null; OPTS.esc = 'KeyO'; OPTS.escLabel = 'O'; saveOpts(); refresh(); });
    extraRefresh.push(function () {
      escSet.textContent = capturing ? 'Press a key\u2026 (Esc cancels)' : (OPTS.esc ? 'Key: ' + OPTS.escLabel + ' \u2014 tap to change' : 'Off \u2014 tap to set a key');
      paint(escSet, !!capturing);
      paint(escOff, !OPTS.esc);
      paint(escO, OPTS.esc === 'KeyO');
    });
    toggle('On-screen ESC button', function () { return OPTS.escBtn; }, function (v) { OPTS.escBtn = v; escBtnUpdate(); }, panel);
    mk('div', 'color:#999;font-size:11px;margin-top:4px',
      'This key presses Escape in the game, so it will not type that letter in chat. Pick a key you do not type (like ` or F9), or use Off.', panel);

    mk('div', 'margin:14px 0 4px;font-weight:700', 'Menu cursor', panel);
    toggle('Custom cursor in menus', function () { return OPTS.cursor; }, function (v) { OPTS.cursor = v; cursorSoon(); }, panel);
    sliderRow('Edge reach', 0, 30, 1, function () { return OPTS.snap; }, function (v) { OPTS.snap = v; },
      function (v) { return v ? v + ' px' : 'off'; }, panel);
    mk('div', 'color:#999;font-size:11px',
      'Replaces the iOS pointer while a menu is open (the pointer is always hidden while playing). Edge reach = how close to the screen edge counts as being exactly on the edge.', panel);

    mk('div', 'margin:14px 0 4px;font-weight:700', 'Camera', panel);
    sliderRow('Mouse sensitivity', 0.5, 5, 0.1, function () { return SENS; }, function (v) { SENS = v; OPTS.sens = v; },
      function (v) { return (+v).toFixed(1); }, panel);
    mk('div', 'color:#999;font-size:11px',
      'The camera follows your real mouse movement. iPad Safari cannot lock the pointer, so the iPadOS pointer still stops at the screen edge; a higher sensitivity means less hand travel to turn the same amount.', panel);

    mk('div', 'margin:12px 0 4px;font-weight:700', 'Touch controls', panel);
    var trow = mk('div', 'display:flex;gap:6px', '', panel);
    var tBtns = [['Auto', 'auto'], ['Hide', 'off'], ['Show', 'on']].map(function (t) {
      var b = mk('button', BTN + ';flex:1', t[0], trow);
      b.addEventListener('click', function () { setTouchMode(t[1]); refresh(); applied.style.display = 'block'; });
      return { el: b, m: t[1] };
    });
    mk('div', 'color:#999;font-size:11px;margin-top:4px',
      'Auto hides the on-screen touch controls while a mouse is in use. Hide always hides them.', panel);
    var applied = mk('div', 'display:none;color:#8fe08f;font-size:12px;margin-top:6px', 'Saved. Close and reopen the game to fully apply.', panel);
    mk('div', 'color:#999;font-size:11px;margin-top:10px', 'Open this panel any time: Alt+E or F8 (or the \u2699 button in a menu).', panel);

    function refresh() {
      extraRefresh.forEach(function (f) { f(); });
      tBtns.forEach(function (t) { paint(t.el, TMODE === t.m); });
    }
    function show() {
      var on = !active();
      if (!root.isConnected && document.body) document.body.appendChild(root);
      root.style.display = on ? 'block' : 'none';
      if (!on) panel.style.display = 'none';
    }
    uiPanel = panel;
    try { new MutationObserver(function () { syncLock(); cursorSoon(); }).observe(panel, { attributes: true, attributeFilter: ['style'] }); } catch (e) {}
    gear.addEventListener('click', function () { capturing = null; panel.style.display = panel.style.display === 'none' ? 'block' : 'none'; refresh(); });
    close.addEventListener('click', function () { capturing = null; panel.style.display = 'none'; refresh(); });
    // Keep clicks/keys on the panel away from the game.
    ['mousedown', 'mouseup', 'click', 'dblclick', 'pointerdown', 'pointerup', 'touchstart', 'touchend', 'wheel', 'keydown', 'keyup']
      .forEach(function (t) { root.addEventListener(t, function (e) { e.stopPropagation(); }); });

    window.addEventListener('keydown', function (e) {
      if (!(e.code === 'F8' || (e.altKey && !e.ctrlKey && !e.metaKey && e.code === 'KeyE'))) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      if (e.repeat) return;
      if (active()) document.exitPointerLock();
      show();
      capturing = null;
      panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
      refresh();
    }, true);

    document.body.appendChild(root);
    document.addEventListener('pointerlockchange', show);
    window.addEventListener('load', show);
    refresh();
    show();
    escBtnUpdate();
    cursorSoon();
  }
  if (document.body) buildUi();
  else document.addEventListener('DOMContentLoaded', buildUi);

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopEdgeLoop();
    else scheduleEdgeLoop();
  });
  window.addEventListener('blur', function () { outside = false; stopEdgeLoop(); });
  window.addEventListener('focus', scheduleEdgeLoop);
  window.addEventListener('resize', scheduleEdgeLoop);
})();
</script>
</head>
<body style="margin:0px;width:100%;height:100%;overflow:hidden;background-color:#000;" id="game_frame">
    <div id="launch_countdown_screen" style="position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;background:#000;color:#f2f2f4;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,system-ui,sans-serif;-webkit-user-select:none;user-select:none;">
        <div style="font-size:28px;font-weight:650;letter-spacing:.04em;">Minecraft</div>
        <div style="font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:#8e8e93;margin-top:-8px;">Java Mobile</div>
        <div style="width:180px;height:3px;border-radius:3px;background:#1c1c1f;overflow:hidden;margin-top:10px;">
            <div id="launchCountdownProgress" style="background:linear-gradient(90deg,#34d399,#60a5fa);width:0%;height:100%;border-radius:3px;"></div>
        </div>
        <span id="launchCountdownNumber" style="display:none">5</span>
        <button id="skipCountdown" autofocus style="margin-top:10px;padding:10px 28px;font-size:15px;font-weight:600;color:#f2f2f4;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:999px;cursor:pointer;-webkit-appearance:none;appearance:none;">Play</button>
    </div>
<script>
    window.addEventListener("load", () => {
        document.getElementById("skipCountdown").click();
    });
</script>
</body>
</html>
