<style id="mc-modern-style">
html,body{background:#000!important}
@keyframes mcSlide{0%{transform:translateX(-110%)}100%{transform:translateX(260%)}}
@keyframes mcFade{0%{opacity:0;transform:translateY(6px)}100%{opacity:1;transform:none}}
.mc-wrap{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
 background:#000;color:#f2f2f4;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,system-ui,sans-serif;
 animation:mcFade .5s ease both;-webkit-user-select:none;user-select:none}
.mc-title{font-size:28px;font-weight:650;letter-spacing:.04em}
.mc-sub{font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:#8e8e93;margin-top:-8px}
.mc-track{position:relative;width:180px;height:3px;border-radius:3px;background:#1c1c1f;overflow:hidden;margin-top:10px}
.mc-bar{position:absolute;top:0;left:0;height:100%;width:40%;border-radius:3px;
 background:linear-gradient(90deg,#34d399,#60a5fa);animation:mcSlide 1.3s cubic-bezier(.4,0,.2,1) infinite}
.mc-note{font-size:12px;color:#636366}
</style>
<script id="mc-modern-loader">
window.__mcLoader=function(a,root){
  try{
    a.style.position='relative';
    var w=document.createElement('div');w.className='mc-wrap';w.id='mc-modern-loader-ui';
    w.innerHTML='<div class="mc-title">Minecraft</div><div class="mc-sub">Java Edition</div>'+
      '<div class="mc-track"><div class="mc-bar"></div></div><div class="mc-note">Loading\u2026</div>';
    a.appendChild(w);
    var done=function(){var e=document.getElementById('mc-modern-loader-ui');if(e&&e.parentNode)e.parentNode.removeChild(e);};
    var mo=new MutationObserver(function(){if(document.querySelector('canvas')){done();mo.disconnect();}});
    mo.observe(document.documentElement,{childList:true,subtree:true});
    setTimeout(function(){mo.disconnect();},600000);
  }catch(e){}
};
</script>
